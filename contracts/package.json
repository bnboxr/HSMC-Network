{
  "name": "hsmc-bridge-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "wHSMC + BridgeMinter — production-ready BEP-20/ERC-20 bridge contracts",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
