# ─── Deployment EOA (must have native gas: BNB/ETH/MATIC/etc.) ─────────
DEPLOYER_PRIVATE_KEY=0x...

# ─── Admin & validator set ────────────────────────────────────────────
# Gnosis Safe address (3-of-5 multisig). Holds admin + pauser roles.
ADMIN_MULTISIG_ADDRESS=0x...

# 5 validator EOAs (comma-separated, no spaces). Threshold = 3 of 5.
VALIDATORS=0xv1,0xv2,0xv3,0xv4,0xv5
THRESHOLD=3

# ─── RPC endpoints ────────────────────────────────────────────────────
# Existing (3 deployable chains)
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
ETH_RPC_URL=https://ethereum.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# New EVM chains (Feature #22)
POLYGON_RPC_URL=https://polygon-rpc.com
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org

# Non-EVM chains (Feature #22)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COSMOS_RPC_URL=https://cosmos-rest.publicnode.com

# ─── Explorer API keys (for `npm run verify:*`) ───────────────────────
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ─── Solana deploy (Feature #22) ──────────────────────────────────────
# Path to a Solana keypair JSON file or base58 private key.
SOLANA_DEPLOYER_KEYPAIR_PATH=~/.config/solana/id.json
# SPL token decimals (8 for wHSMC compatibility)
SPL_TOKEN_DECIMALS=8
# Solana program to use (token-2022 or token)
SOLANA_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# ─── Cosmos deploy (Feature #22) ──────────────────────────────────────
# Mnemonic for the deployer account (Cosmos Hub).
COSMOS_DEPLOYER_MNEMONIC="..."
# Cosmos chain ID (cosmoshub-4 for mainnet)
COSMOS_CHAIN_ID=cosmoshub-4
# Denom for fees (uatom for Cosmos Hub)
COSMOS_FEE_DENOM=uatom
COSMOS_GAS_PRICE=0.025uatom

# ─── PancakeSwap pool seeding (after WHSMC deployed on BSC) ───────────
WHSMC_ADDRESS=0x...
INITIAL_WHSMC=1000000
INITIAL_BNB=10
