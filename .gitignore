# Environment variables — NEVER commit secrets.
# Copy .env.example to .env and fill in real values.
# The API server auto-generates JWT_SECRET / HSMC_API_KEY / DB_ENCRYPTION_KEY
# into .env on first startup when they are missing (see server/config.ts).
.env
.env.*
!.env.example
