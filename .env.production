# HSMC Network — Production Environment Variables
# Copy this file to .env and fill in real values before deploying.

# ── API & Backend ────────────────────────────────────────────────
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Stripe (HSMCPay) ─────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=
HSMC_API_KEY=

# ── TLS (optional, for HTTPS API server) ─────────────────────────
TLS_CERT=
TLS_KEY=

# ── Node ─────────────────────────────────────────────────────────
CORS_ORIGIN=
NODE_ENV=production
