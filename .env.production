# HSMC Network — Production Environment Variables
# Copy this file to .env and fill in real values before deploying.

# ── API & Backend ────────────────────────────────────────────────
VITE_API_URL=
HSMC_TREASURY_ADDRESS=

# ── Stripe (HSMCPay) ─────────────────────────────────────────────
# REAL settlement requires all three keys. Without STRIPE_SECRET_KEY the
# server runs in SIMULATION MODE (dev/testing only — no real money moves):
#   POST /stripe/checkout        { action: "initiate", amount_usd }   → creates PaymentIntent (pi_sim_*)
#   POST /stripe/checkout        { action: "simulate_success", session_id, payment_intent_id } → credits HSMC
#   POST /stripe/payout          { action: "settle", payout_session_id, tx_hash } → burns HSMC
#   POST /stripe/payout/webhook  { type: "payout.paid", data.object.metadata.payout_session_id }
# Set STRIPE_SIMULATION_MODE=true to force simulation even with keys set.
VITE_STRIPE_PUBLISHABLE_KEY=   # pk_live_... / pk_test_... — for the Stripe.js frontend
STRIPE_SECRET_KEY=             # sk_live_... / sk_test_... — creates PaymentIntents & Payouts
STRIPE_WEBHOOK_SECRET=         # whsec_... — verifies webhook signatures (fail-closed when missing)

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=
HSMC_API_KEY=

# ── TLS (optional, for HTTPS API server) ─────────────────────────
TLS_CERT=
TLS_KEY=

# ── Telegram Bot ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── WhatsApp Gateway (Meta Cloud API) ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=3002

# ── Node ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://hsmc-network.ctonew.app,http://localhost:3000
NODE_ENV=production
