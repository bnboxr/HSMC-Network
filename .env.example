# HSMC Network — Production Environment Variables
# Copy this file to .env and fill in real values before deploying.

# ── API & Backend ────────────────────────────────────────────────
VITE_API_URL=
HSMC_TREASURY_ADDRESS=

# ── Stripe (HSMCPay) ─────────────────────────────────────────────
# REAL settlement requires all three keys. Without STRIPE_SECRET_KEY the
# server runs in SIMULATION MODE (dev/testing only — no real money moves):
#   POST /stripe/checkout        { action: "initiate", amount_usd }   → creates PaymentIntent (pi_sim_*)
#   POST /stripe/checkout        { action: "simulate_success", session_id, payment_intent_id } → credits HSMC
#   POST /stripe/payout          — DISABLED by default, returns 410 (see HSMCPAY_SELL_ENABLED)
#   POST /stripe/payout/webhook  — verifies the signature, then settles nothing while sell is off
# Set STRIPE_SIMULATION_MODE=true to force simulation even with keys set.
VITE_STRIPE_PUBLISHABLE_KEY=   # pk_live_... / pk_test_... — for the Stripe.js frontend
STRIPE_SECRET_KEY=             # sk_live_... / sk_test_... — creates PaymentIntents & Payouts
STRIPE_WEBHOOK_SECRET=         # whsec_... — verifies webhook signatures (fail-closed when missing)

# ── HSMCPay feature flags ─────────────────────────────────────────
# Both default to FALSE. Leave them false until the missing rails exist —
# turning them on enables money movement that is not yet safe.
#
# HSMCPAY_SELL_ENABLED — the SELL (HSMC → fiat) flow.
#   Off: POST /stripe/payout returns 410 Gone for both actions, and the payout
#   webhook verifies the Stripe signature, logs the event and returns 200
#   without crediting, debiting or settling anything.
#   Prerequisites before enabling: real on-chain verification of the user's
#   HSMC deposit, and a real payout rail (Connect account / destination) that
#   pays the user instead of the platform's own bank account.
HSMCPAY_SELL_ENABLED=false
#
# TREASURY_BUYBACK_ENABLED — POST /treasury/buyback (buyback & burn).
#   Off: returns 410 Gone and writes nothing. There is no treasury contract and
#   no on-chain buyback, so no burn transaction can be recorded.
TREASURY_BUYBACK_ENABLED=false

# ── Auth ─────────────────────────────────────────────────────────
# If JWT_SECRET / HSMC_API_KEY / DB_ENCRYPTION_KEY are left empty, the server
# auto-generates random values on first startup and persists them to .env
# (gitignored). Set strong values here for production and remove the
# HSMC_API_KEY_AUTOGENERATED=true marker line from .env so API key auth is
# enforced in production.
JWT_SECRET=
HSMC_API_KEY=
DB_ENCRYPTION_KEY=

# ── TLS (optional, for HTTPS API server) ─────────────────────────
TLS_CERT=
TLS_KEY=

# ── Telegram Bot ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── WhatsApp Gateway (Meta Cloud API) ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=3002

# ── Node ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://hsmc-network.ctonew.app,http://localhost:3000
NODE_ENV=production
