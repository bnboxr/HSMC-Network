<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for future node/API calls (Phase 2+). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Biometric unlock for the wallet seed (BiometricPrompt, strong auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Runtime notification permission (API 33+); notifications are Phase 2. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      allowBackup=false is intentional: this wallet holds key material.
      Android auto-backup would copy encrypted blobs + Keystore metadata off-device,
      which is a privacy risk we do not accept for a privacy-focused wallet.
      The BIP39 seed itself is never stored in plaintext anywhere on disk.
    -->
    <application
        android:name=".HsmcApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HSMC.Wallet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
