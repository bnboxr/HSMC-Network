# Copy this file to .env and fill in your values
# cp .env.example .env

# Your miner reward address (replace with real wallet address from the platform)
MINER_ADDRESS=HSMC_YOUR_WALLET_ADDRESS_HERE

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# Ports (change if already occupied)
RPC_PORT=8080
STRATUM_PORT=3333
